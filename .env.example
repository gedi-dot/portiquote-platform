# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only (Project Settings -> API -> service_role). NEVER expose to the browser.
# Used later by the M-Pesa callback / Stripe webhook to write payments & memberships.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# M-Pesa (Safaricom Daraja) — https://developer.safaricom.co.ke
MPESA_ENV=sandbox                         # sandbox | production
MPESA_CONSUMER_KEY=your-daraja-consumer-key
MPESA_CONSUMER_SECRET=your-daraja-consumer-secret
MPESA_SHORTCODE=174379                     # sandbox Lipa na M-Pesa shortcode
MPESA_PASSKEY=your-lipa-na-mpesa-passkey
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback

# Email notifications (Resend) — https://resend.com, free tier is fine to start
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="PortiQuote <hello@your-domain.com>"
EMAIL_ADMIN=you@your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — card fallback for members outside M-Pesa markets (optional)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...           # from the webhook endpoint you create
PREMIUM_PRICE_USD=20                      # card price for 30 days of Premium

# Cron protection — set the same value in Vercel; Vercel Cron sends it as Bearer
CRON_SECRET=generate-a-long-random-string
