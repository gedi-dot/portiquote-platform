# Local development. Copy to .env.local.
#
# For the self-hosted server deployment see deploy/env.example instead — it has a
# different shape, because there the app reads its configuration at runtime and
# these NEXT_PUBLIC_* values are not used.

# Supabase — Project Settings -> API
# In development these are read from the build, which is why they keep the
# NEXT_PUBLIC_ prefix here. In production the server sets SUPABASE_URL and
# SUPABASE_ANON_KEY at runtime instead, so one image can serve both
# environments. See lib/runtime.ts.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only (Project Settings -> API -> service_role). NEVER expose to the
# browser. Used by the M-Pesa / Paystack / Stripe callbacks and the notify
# routes, which need to write past Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical site address, used for SEO metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# This environment's own address, for email links and payment returns. Falls back
# to NEXT_PUBLIC_SITE_URL when unset, which is what you want locally.
# APP_ORIGIN=http://localhost:3000

# M-Pesa (Safaricom Daraja) — https://developer.safaricom.co.ke
MPESA_ENV=sandbox                         # sandbox | production
MPESA_CONSUMER_KEY=your-daraja-consumer-key
MPESA_CONSUMER_SECRET=your-daraja-consumer-secret
MPESA_SHORTCODE=174379                     # sandbox Lipa na M-Pesa shortcode
MPESA_PASSKEY=your-lipa-na-mpesa-passkey
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback

# Email over SMTP. Leave SMTP_HOST unset in development: sendEmails() then logs
# what it would have sent instead of sending it, so no test mail reaches a real
# forwarder's inbox.
# SMTP_HOST=mail.your-domain.com
SMTP_PORT=587
SMTP_USER=noreply@your-domain.com
SMTP_PASS=
SMTP_SENDER_NAME=PortiQuote
EMAIL_FROM="PortiQuote <noreply@your-domain.com>"
EMAIL_ADMIN=you@your-domain.com

# Paystack — card fallback for members outside M-Pesa markets (optional).
# The checkout route answers 501 until this is set.
PAYSTACK_SECRET_KEY=

# Stripe — the other card fallback (optional)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...           # from the webhook endpoint you create
PREMIUM_PRICE_USD=20                      # card price for 30 days of Premium

# Cron protection — sent as a Bearer token by the scheduled membership job
CRON_SECRET=generate-a-long-random-string
