# Template for /opt/portiquote/<env>/.env — root-owned, chmod 600.
#
# setup-server.sh copies this in and generates every secret marked GENERATED, so
# you should only ever have to fill in the SMTP password and the payment keys.
#
# Two environments run from separate copies of this file. The values that MUST
# differ between them are marked PER-ENVIRONMENT; sharing any of those would let
# staging issue tokens that production accepts.

# ============================================================== environment ==
# PER-ENVIRONMENT. Names the compose project and the data directory.
APP_ENV=production

# PER-ENVIRONMENT. This environment's own address. GoTrue signs tokens with it
# and puts it in the links it emails, and the app uses it for payment returns.
# Staging: https://staging.portiquote.com
APP_ORIGIN=https://portiquote.com

# ==================================================================== image ==
# Built once by .github/workflows/release.yml. Promote by changing IMAGE_TAG and
# running `portiquote-deploy`, never by rebuilding.
IMAGE=ghcr.io/gedi-dot/portiquote-platform
# sha-<commit> for staging, v<x.y.z> for production. portiquote-deploy rewrites
# this line when you pass it a tag, so it always records what is actually live.
IMAGE_TAG=

# ==================================================================== ports ==
# PER-ENVIRONMENT, loopback only. DirectAdmin's nginx is the public front door.
# Production 3400/8400, staging 3410/8410. 3100 and 8100 belong to atekercup.
PORT_APP=3400
PORT_SUPABASE=8400

# =================================================================== memory ==
# The box has 11G with other customers' containers on it. These total ~2.2G.
# Staging should run leaner: MEM_DB=512m, MEM_REALTIME=256m, MEM_WEB=512m.
MEM_DB=768m
MEM_AUTH=192m
MEM_REST=192m
MEM_REALTIME=384m
MEM_GATEWAY=64m
MEM_WEB=640m

# ================================================================= database ==
# GENERATED. PER-ENVIRONMENT.
#
# Set once, when the data directory is created. Changing it here later does NOT
# change it in Postgres — the init scripts only run on an empty data directory —
# and the services will simply stop being able to log in. To rotate it, ALTER
# the roles in psql and update this line in the same maintenance window.
POSTGRES_PASSWORD=

# ===================================================================== auth ==
# GENERATED. PER-ENVIRONMENT. Signs every token. ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY are JWTs signed with it, so all three must be
# regenerated together, and one environment's must never appear in the other's.
JWT_SECRET=
JWT_EXPIRY=3600

# GENERATED. Public — it reaches the browser in a cookie and grants only what
# Row Level Security allows.
ANON_KEY=

# GENERATED. SERVER-ONLY. Bypasses Row Level Security entirely. Used by the
# M-Pesa and Paystack callbacks and the notify routes. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Leave false so signups require the emailed confirmation link.
ENABLE_EMAIL_AUTOCONFIRM=false
DISABLE_SIGNUP=false

# ================================================================= realtime ==
# GENERATED. DB_ENC_KEY must be EXACTLY 16 characters — realtime refuses to
# start otherwise, with an error that does not mention the length.
REALTIME_DB_ENC_KEY=
# GENERATED. 64 characters.
SECRET_KEY_BASE=

# ==================================================================== email ==
# The mailbox DirectAdmin holds for the domain. The password is the only secret
# here that setup-server.sh cannot generate for you.
SMTP_HOST=mail.portiquote.com
SMTP_PORT=587
SMTP_USER=noreply@portiquote.com
SMTP_PASS=
SMTP_SENDER_NAME=PortiQuote
EMAIL_FROM="PortiQuote <noreply@portiquote.com>"
# Where contact-form and claim notifications go.
EMAIL_ADMIN=

# ===================================================================== cron ==
# GENERATED. Bearer token for /api/cron/memberships, called by portiquote-cron.
CRON_SECRET=

# ================================================================== payments ==
# M-Pesa (Safaricom Daraja) — https://developer.safaricom.co.ke
# PER-ENVIRONMENT: staging should stay on sandbox.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Must match APP_ORIGIN, and must be reachable from Safaricom over the internet.
MPESA_CALLBACK_URL=https://portiquote.com/api/mpesa/callback

# Paystack — card fallback outside M-Pesa markets. Optional; the checkout route
# answers 501 until it is set.
PAYSTACK_SECRET_KEY=

# Stripe — optional, same as above.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Card price for 30 days of Premium.
PREMIUM_PRICE_USD=20
