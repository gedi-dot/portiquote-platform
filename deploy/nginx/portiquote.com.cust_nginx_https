# Production: portiquote.com
#
# Install as:
#
#   /usr/local/directadmin/data/users/admin/domains/portiquote.com.cust_nginx_https
#
# Then rebuild and reload:
#
#   cd /usr/local/directadmin/custombuild && ./build rewrite_confs
#   nginx -t && systemctl reload nginx
#
# The suffix chooses which server block DirectAdmin inserts this into:
# `.cust_nginx_https` is HTTPS only, `.cust_nginx_http` is HTTP only, and plain
# `.cust_nginx` is both. HTTPS only is right here, because Force SSL redirects
# plain HTTP before it would ever reach a proxy.
#
# DirectAdmin owns the surrounding `server` block, the certificate and the
# redirects. This file only adds location blocks inside it, so do not add
# listen, server_name or ssl_* directives here. The shape matches
# tenant.ngamiacloud.co.ke.cust_nginx_https, which already works on this server.
#
# IMPORTANT: nginx on this server must stay DirectAdmin's CustomBuild build.
# Ubuntu's nginx package is apt-held because it once overwrote it and took every
# site down. Never `apt install nginx` to satisfy anything in this file.

# ---------------------------------------------------------------- Supabase ----
# The browser talks to Supabase same-origin; these three prefixes are what
# supabase-js appends to its base URL. The path is passed through unchanged,
# because the gateway container expects to see the prefix and strips it itself.
location /auth/v1/ {
    proxy_pass http://127.0.0.1:8400;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location /rest/v1/ {
    proxy_pass http://127.0.0.1:8400;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# WebSocket. Without the upgrade headers the three live message threads fall back
# to nothing and simply never update.
location /realtime/v1/ {
    proxy_pass http://127.0.0.1:8400;
    proxy_http_version 1.1;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        "upgrade";
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
}

# --------------------------------------------------------------------- app ----
location / {
    proxy_pass http://127.0.0.1:3400;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Next streams its responses; buffering them defeats that and delays the
    # first byte until the whole page is ready.
    proxy_buffering off;
    proxy_read_timeout 60s;
}
