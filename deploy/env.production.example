# /opt/portiquote/.env — root:root, mode 600. Read by docker compose.
#
# Same Supabase project as the Vercel deployment, so both see the same data.
# Everything else below is specific to this deployment.

# ---- Supabase (Project Settings -> API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- This site ----------------------------------------------------------------
# Canonical URLs, sitemap, email links and payment return URLs all follow this.
NEXT_PUBLIC_SITE_URL=https://portiquote.com
NEXT_PUBLIC_SITE_NAME=PortiQuote
# Loopback port DirectAdmin's nginx proxies to. Must be free on the host.
PORTIQUOTE_HOST_PORT=3100

# ---- Cron ---------------------------------------------------------------------
# Any long random string: openssl rand -hex 32
CRON_SECRET=generate-a-long-random-string

# ---- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="PortiQuote <hello@portiquote.com>"
EMAIL_ADMIN=your-admin-inbox

# ---- M-Pesa (Daraja) ----------------------------------------------------------
# The callback URL travels with each payment request, so pointing it here is
# safe while Vercel still runs: each deployment receives its own callbacks.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your-daraja-consumer-key
MPESA_CONSUMER_SECRET=your-daraja-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-lipa-na-mpesa-passkey
MPESA_CALLBACK_URL=https://portiquote.com/api/mpesa/callback

# ---- Card payments ------------------------------------------------------------
# Leave a provider's key empty to hide it. Its webhook is registered in the
# provider's dashboard: see DEPLOY.md before adding a second endpoint.
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PREMIUM_PRICE_USD=20
