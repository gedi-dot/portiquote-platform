#!/usr/bin/env bash
#
# Daily membership housekeeping for one environment: renewal reminders, then
# expiring lapsed Premium.
#
#     portiquote-cron production
#
# Runs from /etc/cron.d/portiquote as root, because the secret lives in the
# root-only /opt/portiquote/<env>/.env.
#
# Scheduled for production only. Staging shares no data with it and has no real
# memberships to expire, and pointing this at staging would send test reminders
# to real addresses if staging ever held a copy of live data.

set -euo pipefail
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

ENV_NAME="${1:-production}"
case "$ENV_NAME" in
    production|staging) ;;
    *) echo "usage: portiquote-cron {production|staging}" >&2; exit 2 ;;
esac

ENV_FILE="/opt/portiquote/${ENV_NAME}/.env"
[ -f "$ENV_FILE" ] || { echo "portiquote-cron: no ${ENV_FILE}" >&2; exit 1; }

envval() { sed -n "s/^$1=//p" "$ENV_FILE" | tr -d '"' | tail -1; }

SECRET="$(envval CRON_SECRET)"
PORT="$(envval PORT_APP)"
[ -n "$SECRET" ] || { echo "portiquote-cron: CRON_SECRET missing from $ENV_FILE" >&2; exit 1; }
[ -n "$PORT" ]   || { echo "portiquote-cron: PORT_APP missing from $ENV_FILE" >&2; exit 1; }

# The secret goes through a header file, not the command line, so it never
# appears in the process list — where any user on the box could read it.
HDR="$(mktemp)"; trap 'rm -f "$HDR"' EXIT
printf 'Authorization: Bearer %s\n' "$SECRET" > "$HDR"

curl -fsS --max-time 300 -H @"$HDR" "http://127.0.0.1:${PORT}/api/cron/memberships"
echo
