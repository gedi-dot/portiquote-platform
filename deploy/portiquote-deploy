#!/usr/bin/env bash
#
# Deploys the latest main to https://portiquote.com.
#
#     sudo portiquote-deploy
#
# Installed root-owned to /usr/local/sbin by setup-server.sh. It takes no
# arguments on purpose: a sudoers rule can then grant exactly this command to a
# CI account without granting anything else.
#
# If the new build fails its health check, the previous image is put back.

set -euo pipefail
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

ROOT=/opt/portiquote
SRC="${ROOT}/src"
BRANCH=main
LOG="${ROOT}/deploy.log"

die() { echo "deploy: $*" >&2; echo "$(date '+%F %T')  FAILED  $*" >> "$LOG"; exit 1; }

[ "$(id -u)" -eq 0 ] || { echo "Run with sudo." >&2; exit 1; }
cd "$ROOT"

exec 9> /run/portiquote-deploy.lock
flock -n 9 || die "another deploy is already running"

[ -f .env ] || die "no ${ROOT}/.env — copy deploy/env.production.example and fill it in"
# An unfilled template builds fine and then fails at runtime in confusing ways.
if grep -qE '=(your-|YOUR-|sk_test_\.\.\.|whsec_\.\.\.|generate-)' .env; then
    die ".env still has template placeholders: $(grep -oE '^[A-Z_]+=(your-|YOUR-|sk_test_|whsec_|generate-)' .env | cut -d= -f1 | tr '\n' ' ')"
fi
HOST_PORT="$(sed -n 's/^PORTIQUOTE_HOST_PORT=//p' .env | tr -d '"' | tail -1)"
HOST_PORT="${HOST_PORT:-3100}"

git -C "$SRC" fetch --quiet origin "$BRANCH" \
    || die "cannot fetch from GitHub — check the deploy key (re-run setup-server.sh to diagnose)"
git -C "$SRC" reset --quiet --hard "origin/${BRANCH}"
REV="$(git -C "$SRC" log -1 --format='%h %s' | cut -c1-72)"
echo "Deploying ${REV}"

if docker image inspect portiquote-web:latest > /dev/null 2>&1; then
    docker tag portiquote-web:latest portiquote-web:previous
    HAVE_PREVIOUS=1
else
    HAVE_PREVIOUS=0
fi

docker compose build --pull web || die "build failed at ${REV} (site still on the previous version)"
docker compose up -d web

# Two checks. robots.txt proves Node is serving. /directory is rendered per
# request from Supabase, so it proves the container can reach the database —
# a container with broken outbound networking passes the first and fails this.
healthy() {
    local path code
    for path in /robots.txt /directory; do
        code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 "http://127.0.0.1:${HOST_PORT}${path}")"
        [ "$code" = 200 ] || { echo "  ${path} -> ${code}"; return 1; }
    done
}

# Up to ~3 minutes: a start-up takes seconds, so this only runs long when
# something is genuinely wrong.
for _ in $(seq 1 12); do
    if healthy > /dev/null; then
        echo "$(date '+%F %T')  ok  ${REV}" >> "$LOG"
        docker image prune -f > /dev/null
        echo "Live: ${REV}"
        exit 0
    fi
    sleep 3
done

echo "Health check failed:"; healthy || true
docker compose logs --tail 40 web || true
if [ "$HAVE_PREVIOUS" -eq 1 ]; then
    docker tag portiquote-web:previous portiquote-web:latest
    docker compose up -d --no-build web
    die "${REV} failed its health check; rolled back to the previous image"
fi
die "${REV} failed its health check and there is no previous image to roll back to"
